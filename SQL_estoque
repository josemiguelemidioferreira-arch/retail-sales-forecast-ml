
-- =====================================================
-- PROJETO: SISTEMA DE GERENCIAMENTO DE ESTOQUE (SGE)
-- BANCO DE DADOS: MySQL 8.0
-- DDL + DML + CONSULTAS
-- =====================================================

CREATE DATABASE IF NOT EXISTS sistema_estoque;
USE sistema_estoque;


-- =====================================================
-- PARTE 1: DDL - CRIACAO DAS TABELAS
-- =====================================================

-- CENARIO 1: CONFIGURACAO INICIAL DA LOJA

-- 1. CATEGORIAS
CREATE TABLE categorias (
    id_categoria INT AUTO_INCREMENT,
    nome VARCHAR(100) NOT NULL UNIQUE,
    descricao VARCHAR(255),
    status BOOLEAN DEFAULT TRUE,
    data_cadastro TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (id_categoria)
);

-- 2. FORNECEDORES
CREATE TABLE fornecedores (
    id_fornecedor INT AUTO_INCREMENT,
    nome VARCHAR(120) NOT NULL,
    cnpj VARCHAR(18) NOT NULL UNIQUE,
    telefone VARCHAR(20),
    email VARCHAR(120),
    cidade VARCHAR(100),
    PRIMARY KEY (id_fornecedor)
);

-- 3. CLIENTES
CREATE TABLE clientes (
    id_cliente INT AUTO_INCREMENT,
    nome VARCHAR(120) NOT NULL,
    cpf VARCHAR(14) NOT NULL UNIQUE,
    telefone VARCHAR(20),
    email VARCHAR(120),
    data_cadastro TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (id_cliente)
);

-- 4. FUNCIONARIOS
CREATE TABLE funcionarios (
    id_funcionario INT AUTO_INCREMENT,
    nome VARCHAR(120) NOT NULL,
    cpf VARCHAR(14) NOT NULL UNIQUE,
    cargo VARCHAR(80) NOT NULL,
    salario DECIMAL(10,2) NOT NULL,
    data_admissao DATE NOT NULL,
    PRIMARY KEY (id_funcionario),
    CHECK (salario >= 0)
);

-- 5. PRODUTOS
CREATE TABLE produtos (
    id_produto INT AUTO_INCREMENT,
    nome VARCHAR(120) NOT NULL,
    descricao VARCHAR(255),
    preco_venda DECIMAL(10,2) NOT NULL,
    estoque_atual INT DEFAULT 0,
    estoque_minimo INT DEFAULT 5,
    id_categoria INT NOT NULL,
    id_fornecedor INT NOT NULL,
    PRIMARY KEY (id_produto),

    CONSTRAINT fk_produto_categoria
    FOREIGN KEY (id_categoria)
    REFERENCES categorias(id_categoria),

    CONSTRAINT fk_produto_fornecedor
    FOREIGN KEY (id_fornecedor)
    REFERENCES fornecedores(id_fornecedor),

    CHECK (preco_venda > 0),
    CHECK (estoque_atual >= 0),
    CHECK (estoque_minimo >= 0)
);

-- 6. COMPRAS
CREATE TABLE compras (
    id_compra INT AUTO_INCREMENT,
    id_fornecedor INT NOT NULL,
    id_funcionario INT NOT NULL,
    data_compra DATE NOT NULL,
    valor_total DECIMAL(10,2) NOT NULL,
    status VARCHAR(20) DEFAULT 'Recebida',
    PRIMARY KEY (id_compra),

    FOREIGN KEY (id_fornecedor)
    REFERENCES fornecedores(id_fornecedor),

    FOREIGN KEY (id_funcionario)
    REFERENCES funcionarios(id_funcionario),

    CHECK (valor_total >= 0),
    CHECK (status IN ('Recebida', 'Pendente', 'Cancelada'))
);

-- 7. ITENS DA COMPRA
CREATE TABLE itens_compra (
    id_item_compra INT AUTO_INCREMENT,
    id_compra INT NOT NULL,
    id_produto INT NOT NULL,
    quantidade INT NOT NULL,
    preco_unitario DECIMAL(10,2) NOT NULL,
    subtotal DECIMAL(10,2) NOT NULL,
    PRIMARY KEY (id_item_compra),

    FOREIGN KEY (id_compra)
    REFERENCES compras(id_compra),

    FOREIGN KEY (id_produto)
    REFERENCES produtos(id_produto),

    CHECK (quantidade > 0),
    CHECK (preco_unitario > 0),
    CHECK (subtotal >= 0)
);

-- 8. VENDAS
CREATE TABLE vendas (
    id_venda INT AUTO_INCREMENT,
    id_cliente INT NOT NULL,
    id_funcionario INT NOT NULL,
    data_venda DATE NOT NULL,
    valor_total DECIMAL(10,2) NOT NULL,
    forma_pagamento VARCHAR(30) NOT NULL,
    PRIMARY KEY (id_venda),

    FOREIGN KEY (id_cliente)
    REFERENCES clientes(id_cliente),

    FOREIGN KEY (id_funcionario)
    REFERENCES funcionarios(id_funcionario),

    CHECK (valor_total >= 0)
);

-- 9. ITENS DA VENDA
CREATE TABLE itens_venda (
    id_item_venda INT AUTO_INCREMENT,
    id_venda INT NOT NULL,
    id_produto INT NOT NULL,
    quantidade INT NOT NULL,
    preco_unitario DECIMAL(10,2) NOT NULL,
    subtotal DECIMAL(10,2) NOT NULL,
    PRIMARY KEY (id_item_venda),

    FOREIGN KEY (id_venda)
    REFERENCES vendas(id_venda),

    FOREIGN KEY (id_produto)
    REFERENCES produtos(id_produto),

    CHECK (quantidade > 0),
    CHECK (preco_unitario > 0),
    CHECK (subtotal >= 0)
);


