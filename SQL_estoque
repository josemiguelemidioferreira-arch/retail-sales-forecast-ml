-- CENARIO 6: ATUALIZACAO DO ESTOQUE
-- O sistema desconta os produtos vendidos.

UPDATE produtos p
SET estoque_atual = estoque_atual - (
    SELECT COALESCE(SUM(iv.quantidade), 0)
    FROM itens_venda iv
    INNER JOIN vendas v
    ON v.id_venda = iv.id_venda
    WHERE iv.id_produto = p.id_produto
);


-- =====================================================
-- PARTE 3: CONSULTAS PARA VALIDACAO DO SISTEMA
-- =====================================================

-- 1. CONSULTAR TODOS OS PRODUTOS
SELECT * FROM produtos;

-- 2. CONSULTAR PRODUTOS COM ESTOQUE BAIXO
SELECT nome, estoque_atual, estoque_minimo
FROM produtos
WHERE estoque_atual <= estoque_minimo;

-- 3. PRODUTOS E SUAS CATEGORIAS
SELECT
    p.nome AS produto,
    c.nome AS categoria,
    p.preco_venda,
    p.estoque_atual
FROM produtos p
INNER JOIN categorias c
ON p.id_categoria = c.id_categoria;

-- 4. HISTORICO DE VENDAS
SELECT
    v.id_venda,
    cl.nome AS cliente,
    f.nome AS funcionario,
    v.data_venda,
    v.valor_total,
    v.forma_pagamento
FROM vendas v
INNER JOIN clientes cl
ON v.id_cliente = cl.id_cliente
INNER JOIN funcionarios f
ON v.id_funcionario = f.id_funcionario;

-- 5. FATURAMENTO TOTAL
SELECT SUM(valor_total) AS faturamento
FROM vendas;

