-- Atualizacao do estoque com os produtos recebidos.

UPDATE produtos p
SET estoque_atual = (
    SELECT COALESCE(SUM(ic.quantidade), 0)
    FROM itens_compra ic
    INNER JOIN compras c
    ON c.id_compra = ic.id_compra
    WHERE ic.id_produto = p.id_produto
    AND c.status = 'Recebida'
);


